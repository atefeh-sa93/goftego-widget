{
  "name": "goftego-widget",
  "version": "0.0.0",
  "description": "Framework-agnostic embeddable AI chat widget built with Lit web components and Shadow DOM",
  "type": "module",
  "license": "MIT",
  "author": "Atefeh (https://github.com/atefeh-sa93)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/atefeh-sa93/goftego-widget.git"
  },
  "keywords": [
    "web-components",
    "lit",
    "shadow-dom",
    "custom-elements",
    "chat",
    "widget",
    "sse"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "@vitest/browser-playwright": "^5.1.0",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-lit": "^2.3.1",
    "eslint-plugin-wc": "^3.1.0",
    "globals": "^17.14.0",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@11.5.3"
}
